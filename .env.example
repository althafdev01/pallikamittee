# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.

# Generate a strong key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
ALLOWED_HOSTS=vvjmpallicommitte.online,www.vvjmpallicommitte.online,52.66.24.124

# SQLite is the default — leave DATABASE_URL unset to keep it.
# To use Postgres, uncomment and fill in:
# DATABASE_URL=postgres://db_user:db_password@localhost:5432/pallikamitti

# Set to False only if you are terminating SSL on a load balancer that already
# sends the HTTPS header (e.g. nginx sets X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True
